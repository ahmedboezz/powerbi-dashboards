	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Product", type text}, {"Product Type", type text}, {"SLA Days", Int64.Type}, {"Product Order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

