model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "Ad Performance", "Campaigns", "Channels", "Budget", "Funnel", "Channel Daily", "Budget Change", "Date", "_Measures"]

ref table 'Ad Performance'
ref table Campaigns
ref table Channels
ref table Budget
ref table Funnel
ref table 'Channel Daily'
ref table 'Budget Change'
ref table Date
ref table _Measures
