	partition Branches = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "branches.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Branch", type text}, {"Zone", type text}, {"Seats", Int64.Type}, {"Opened", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

