	partition 'Change Orders' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "change_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),

				    Typed = Table.TransformColumnTypes(Promoted, {{"SubmittedDate", type date}, {"Amount", type number}, {"ScheduleImpactDays", Int64.Type}}, "en-US"),
				    Result = Table.TransformColumns(Typed, {{"Status", Text.Proper, type text}})
				in
				    Result

	annotation PBI_ResultType = Table
