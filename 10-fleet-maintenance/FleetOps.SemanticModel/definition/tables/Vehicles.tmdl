table Vehicles
	lineageTag: d85dc98f-9e82-5928-b0a1-a13ece2641a1

	column VehicleID
		dataType: string
		lineageTag: e4cc8fac-1f91-5066-9be5-25958a2a614f
		summarizeBy: none
		sourceColumn: VehicleID

		annotation SummarizationSetBy = Automatic

	column VehicleType
		dataType: string
		lineageTag: e66522bd-deeb-5cc0-94ef-9930d43d2b85
		summarizeBy: none
		sourceColumn: VehicleType

		annotation SummarizationSetBy = Automatic

	column Make
		dataType: string
		lineageTag: fbeadeb3-8df2-5ca2-ae8e-cc26e5f6e29c
		summarizeBy: none
		sourceColumn: Make

		annotation SummarizationSetBy = Automatic

	column ModelYear
		dataType: int64
		formatString: 0
		lineageTag: 25f4892b-c2e8-5481-a59c-abec92a3c546
		summarizeBy: none
		sourceColumn: ModelYear

		annotation SummarizationSetBy = Automatic

	column Branch
		dataType: string
		lineageTag: bf4915e4-7025-5cfc-a0ee-ccde4048de7f
		summarizeBy: none
		sourceColumn: Branch

		annotation SummarizationSetBy = Automatic

	column FuelType
		dataType: string
		lineageTag: 1895acc8-6b24-5d4d-b2b2-65d66be68d56
		summarizeBy: none
		sourceColumn: FuelType

		annotation SummarizationSetBy = Automatic

	column PurchaseCost
		dataType: double
		formatString: #,0
		lineageTag: 217073a3-6b9a-5aa8-8552-2ae972ce4ef5
		summarizeBy: sum
		sourceColumn: PurchaseCost

		annotation SummarizationSetBy = Automatic

	column 'Age (years)'
		dataType: int64
		formatString: 0
		lineageTag: 3c38d99a-470d-5e1a-94b8-15799402f629
		summarizeBy: none
		sourceColumn: Age (years)

		annotation SummarizationSetBy = Automatic

	column 'Age Band'
		dataType: string
		lineageTag: 3107e875-2801-56b6-ae63-bc87b773b6fc
		summarizeBy: none
		sourceColumn: Age Band
		sortByColumn: 'Age Band Order'

		annotation SummarizationSetBy = Automatic

	column 'Age Band Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 29b49bf4-39c4-59b3-bb24-1d54d2572ed3
		summarizeBy: none
		sourceColumn: Age Band Order

		annotation SummarizationSetBy = Automatic

	partition Vehicles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "vehicles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),

				    Typed = Table.TransformColumnTypes(Promoted, {{"ModelYear", Int64.Type}, {"PurchaseCost", type number}}, "en-US"),
				    Age = Table.AddColumn(Typed, "Age (years)", each 2025 - [ModelYear], Int64.Type),
				    Band = Table.AddColumn(Age, "Age Band", each if [#"Age (years)"] <= 3 then "0-3 years" else if [#"Age (years)"] <= 6 then "4-6 years" else "7+ years", type text),
				    Result = Table.AddColumn(Band, "Age Band Order", each if [#"Age (years)"] <= 3 then 1 else if [#"Age (years)"] <= 6 then 2 else 3, Int64.Type)
				in
				    Result

	annotation PBI_ResultType = Table
