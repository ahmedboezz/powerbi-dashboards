model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "Calls", "Agents", "Queues", "Agent Logins", "Date", "_Measures"]

ref table Calls
ref table Agents
ref table Queues
ref table 'Agent Logins'
ref table Date
ref table _Measures
