model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "Shipments", "Carriers", "Date", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Shipments
ref table Carriers
ref table Date
ref table _Measures

